# Git attributes for Node.js project

# Ensure consistent line endings
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.p12 binary
*.pfx binary
*.wsdl binary
*.xsd binary

# Export ignore for npm package
/test export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/.eslintrc.json export-ignore
/.prettierrc.json export-ignore
/dev-server.js export-ignore