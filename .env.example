# TWINT SDK Environment Configuration

# Certificate Configuration
TWINT_CERTIFICATE_PATH=certificate.p12
TWINT_CERTIFICATE_PASSWORD=your-certificate-password

# TWINT Configuration  
TWINT_STORE_UUID=your-store-uuid-here

# Environment: PRODUCTION, INTEGRATION, or STAGING
TWINT_ENVIRONMENT=INTEGRATION

# Server Configuration
PORT=3000
LOG_LEVEL=info

# Debug Options
# Set to 'true' to see formatted SOAP XML requests/responses in console
SOAP_DEBUG=false