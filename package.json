{
  "name": "twint-node-sdk",
  "version": "1.0.2",
  "description": "Node.js SDK for TWINT payment integration",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently --kill-others --kill-others-on-fail \"npm:dev-server\" \"npm:dev\"",
    "dev": "web-dev-server --config web-dev-server.config.mjs",
    "dev-server": "node --watch dev-server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint src test --ext .js",
    "lint:fix": "eslint src test --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\""
  },
  "keywords": [
    "twint",
    "payment",
    "switzerland",
    "checkout",
    "express-checkout",
    "sdk",
    "api"
  ],
  "author": "Ilyas Türkben",
  "license": "MIT",
  "homepage": "https://github.com/yesil/twint-node-sdk",
  "repository": {
    "type": "git",
    "url": "git@github.com:yesil/twint-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/yesil/twint-node-sdk/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "soap": "^1.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0"
  },
  "optionalDependencies": {
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "lit": "^3.1.0",
    "qrcode": "^1.5.3",
    "xml-formatter": "^3.6.6"
  },
  "devDependencies": {
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-esbuild": "^1.0.2",
    "eslint": "^8.54.0",
    "koa-proxies": "^0.12.4",
    "prettier": "^3.1.0"
  }
}
